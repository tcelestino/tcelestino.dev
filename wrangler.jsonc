{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tcelestino-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "tcelestino.dev.br", "custom_domain": true },
    { "pattern": "www.tcelestino.dev.br", "custom_domain": true }
  ]
}
